<c:Procedures>
<o:Procedure Id="o71">
<a:ObjectID>092CA25D-1510-4C5B-BF6C-79B3D130ABE2</a:ObjectID>
<a:Name>PODACI ZA OSOBU</a:Name>
<a:Code>PODACI_ZA_OSOBU</a:Code>
<a:CreationDate>1670682597</a:CreationDate>
<a:Creator>Ljubica</a:Creator>
<a:ModificationDate>1670780088</a:ModificationDate>
<a:Modifier>Ljubica</a:Modifier>
<a:BeginScript>delimiter //
create procedure %PROC% (IN email varchar(40))
AS
begin
select OSOBLJE.PREZIME, OSOBLJE.IME, ADRESA.NAZIV_ULICE,
ADRESA.KUCNI_BROJ, MESTO.NAZIV_MESTA, DRZAVA.NAZIV_DRZAVE, 
OSOBLJE.TELEFON, OSOBLJE.POL, OSOBLJE.EMAIL,
from 
OSOBLJE, DRZAVA, MESTO, ADRESA, POSTOJI

where 
MESTO.ID_DRZAVE = POSTOJI.ID_DRZAVE AND
MESTO.PTT_BROJ = POSTOJI.PTT_BROJ AND
ADRESA.ID_ADRESE = POSTOJI.ID_ADRESE AND
ADRESA.ID_ADRESE = OSOBLJE.ID_ADRESE 
order by OSOBLJE.PREZIME, OSOBLJE.IME
end //
delimiter;</a:BeginScript>
</o:Procedure>
</c:Procedures>

<o:View Id="o69">
<a:ObjectID>471507A9-8D17-4B04-AC8A-000A4FDC084E</a:ObjectID>
<a:Name>SVO OSOBLJE U FRIZERSKOM SALONU</a:Name>
<a:Code>SVO_OSOBLJE_U_FRIZERSKOM_SALONU</a:Code>
<a:CreationDate>1670682592</a:CreationDate>
<a:Creator>Ljubica</a:Creator>
<a:ModificationDate>1670779901</a:ModificationDate>
<a:Modifier>Ljubica</a:Modifier>
<a:View.SQLQuery>select 
OSOBLJE.PREZIME, OSOBLJE.IME, OSOBLJE.TELEFON, 
OSOBLJE.EMAIL,MESTO.NAZIV_MESTA, 
DRZAVA.NAZIV_DRZAVE, ADRESA.KUCNI_BROJ, ADRESA.NAZIV_ULICE 
 POSTOJI.ID_ADRESE, POSTOJI.ID_DRZAVE, POSTOJI.PTT_BROJ
from OSOBLJE, ADRESA, MESTO, DRZAVA, POSTOJI
where MESTO.ID_DRZAVE = POSTOJI.ID_DRZAVE AND
MESTO.PTT_BROJ = POSTOJI.PTT_BROJ AND
ADRESA.ID_ADRESE = POSTOJI.ID_ADRESE AND
ADRESA.ID_ADRESE = OSOBLJE.ID_ADRESE
order by OSOBLJE.PREZIME, OSOBLJE.IME</a:View.SQLQuery>
